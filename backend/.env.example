DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trackme
REDIS_URL=redis://localhost:6379/0
LOCAL_AUTH_ENABLED=true
PILOT_BOOTSTRAP_ORG_ID=11111111-1111-1111-1111-111111111111
PILOT_BOOTSTRAP_ORG_SLUG=pilot-org
PILOT_BOOTSTRAP_ORG_NAME=TrackMe Pilot
PILOT_BOOTSTRAP_ADMIN_EMAIL=admin@pilot.local
PILOT_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
PILOT_BOOTSTRAP_ADMIN_NAME=Pilot Admin
PILOT_BOOTSTRAP_ADMIN_ROLE=admin
JWT_ISSUER=https://issuer.example.com
JWT_AUDIENCE=trackme-api
JWT_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
JWT_SHARED_SECRET=replace-with-strong-secret
JWT_ALGORITHMS=HS256
ALLOW_INSECURE_JWT_FOR_DEV=false
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
SIGNED_TELEMETRY_MODE=required
ALLOW_PLACEHOLDER_SIGNED_TELEMETRY=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COMMAND_SIGNING_PRIVATE_KEY_PATH=backend/secrets/command-signing-private.pem
COMMAND_SIGNING_PUBLIC_KEY_PATH=backend/secrets/command-signing-public.pem
WORKER_POLL_INTERVAL_SECONDS=2.0
WORKER_IDLE_SLEEP_SECONDS=2.0
WORKER_MAX_EVENTS_PER_TICK=100
WORKER_NAME=trackme-rules-worker
FCM_SERVER_KEY=
